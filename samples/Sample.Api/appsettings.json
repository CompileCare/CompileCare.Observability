{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317", // "http://host.docker.internal:4317"
    "ServiceName": "Sample.Api"
  },  
    "ElasticConfiguration": {
      "Uri": "http://localhost:9200"
    },
    "Serilog": {
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "System": "Warning"
        }
      },
      "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
      "WriteTo": [
        { "Name": "Console" },
        {
          "Name": "Elasticsearch",
          "Args": {
            "nodeUris": "http://localhost:9200",
            "indexFormat": "SampeApi-logs-{0:yyyy.MM}"
          }
        }
      ]
    }
  }
